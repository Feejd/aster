# Obraz systemu Aster: Fedora Kinoite (atomowa Fedora z KDE) + powłoka Aster.
# Szkic — budowanie i instalację obrazu sprawdzimy po tym, jak powłoka będzie działać w maszynie wirtualnej.
#   podman build -f image/Containerfile -t aster:latest .
ARG FEDORA=44

FROM registry.fedoraproject.org/fedora:${FEDORA} AS build
RUN dnf install -y cmake ninja-build gcc-c++ extra-cmake-modules python3 \
        qt6-qtbase-devel qt6-qtdeclarative-devel layer-shell-qt-devel kf6-kwindowsystem-devel kf6-kservice-devel kf6-kio-devel kf6-kconfig-devel libxcrypt-devel libvterm-devel polkit-qt6-1-devel qt6-qtwebengine-devel plasma-workspace-devel exiv2-devel qt6-qtpdf-devel kf6-syntax-highlighting-devel qt6-qtmultimedia-devel taglib-devel libarchive-devel kf6-solid-devel plasma-wayland-protocols-devel kf6-kguiaddons-devel sane-backends-devel qt6-qtbase-private-devel pipewire-devel libsndfile-devel libsamplerate-devel alsa-lib-devel qt6-qtsvg-devel kf6-prison-devel librsvg2-tools xcursorgen mlt-devel whisper-cpp-devel
COPY CMakeLists.txt /src/
COPY common /src/common
COPY shell /src/shell
COPY apps /src/apps
COPY session /src/session
COPY data /src/data
COPY tools/make-cursors.py /src/tools/make-cursors.py
RUN cmake -S /src -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
 && cmake --build /build \
 && DESTDIR=/out cmake --install /build

FROM quay.io/fedora/fedora-kinoite:${FEDORA}
COPY --from=build /out/ /
RUN dnf install -y google-roboto-fonts layer-shell-qt libvterm jetbrains-mono-fonts-all exiv2-libs kf6-kimageformats qt6-qtimageformats qt6-qtpdf qt6-qtmultimedia taglib exfatprogs dosfstools ntfsprogs google-noto-color-emoji-fonts sane-backends sane-backends-drivers-scanners sane-airscan kdeconnectd \
        mlt mlt-qt6 openh264 whisper-cpp \
RUN dnf install -y google-roboto-fonts layer-shell-qt libvterm jetbrains-mono-fonts-all exiv2-libs kf6-kimageformats qt6-qtimageformats qt6-qtpdf qt6-qtmultimedia taglib libsndfile libsamplerate alsa-lib exfatprogs dosfstools ntfsprogs google-noto-color-emoji-fonts sane-backends sane-backends-drivers-scanners sane-airscan kdeconnectd \
RUN dnf install -y google-roboto-fonts layer-shell-qt libvterm git jetbrains-mono-fonts-all exiv2-libs kf6-kimageformats qt6-qtimageformats qt6-qtpdf qt6-qtmultimedia taglib exfatprogs dosfstools ntfsprogs google-noto-color-emoji-fonts sane-backends sane-backends-drivers-scanners sane-airscan kdeconnectd \
        glibc-langpack-pl glibc-langpack-en glibc-langpack-de glibc-langpack-uk glibc-langpack-cs glibc-langpack-fr glibc-langpack-es glibc-langpack-it \
 && kwriteconfig6 --file /etc/xdg/kdeglobals --group General --key TerminalApplication aster-terminal \
 && kwriteconfig6 --file /etc/xdg/kdeglobals --group General --key TerminalService org.aster.terminal.desktop \
 # Kursor Aster wszędzie: KDE/KWin, programy X11 i GTK (Firefox), ekran logowania (10-aster-sddm.conf)
 && kwriteconfig6 --file /etc/xdg/kcminputrc --group Mouse --key cursorTheme Aster \
 && kwriteconfig6 --file /etc/xdg/klaunchrc --group BusyCursorSettings --key Bouncing false \
 && kwriteconfig6 --file /etc/xdg/klaunchrc --group BusyCursorSettings --key Blinking false \
 && mkdir -p /usr/share/icons/default && printf '[Icon Theme]\nInherits=Aster\n' > /usr/share/icons/default/index.theme \
 && printf "[org.gnome.desktop.interface]\ncursor-theme='Aster'\n" > /usr/share/glib-2.0/schemas/90-aster-cursor.gschema.override \
 && glib-compile-schemas /usr/share/glib-2.0/schemas \
 && systemctl --global enable aster-shell.service \
 # Konto i ustawienia z instalatora przy pierwszym starcie (tools/build-iso.sh, apps/installer)
 && systemctl enable aster-firstboot.service \
 && dnf clean all

# ——— Bez zdublowanych programów: KDE-owe okna zastąpione przez Aster znikają (infrastruktura KDE zostaje) ———
COPY image/debloat.sh /tmp/debloat.sh
RUN sh /tmp/debloat.sh && rm -f /tmp/debloat.sh && dnf clean all

# ——— Start jak w macOS: znak Aster, bez tekstu, od razu do sesji Aster ———
COPY image/boot/10-aster.toml /usr/lib/bootc/kargs.d/10-aster.toml
COPY image/boot/10-aster-sddm.conf /etc/sddm.conf.d/10-aster.conf
COPY image/boot/10-aster-plymouth.conf /usr/lib/systemd/system/sddm.service.d/10-aster-plymouth.conf
RUN dnf install -y plymouth-plugin-script sddm sddm-wayland-plasma \
 # Ekran logowania: SDDM z motywem Aster zamiast Plasma Login Manager (tamten nie przyjmuje własnych motywów)
 && (systemctl disable plasmalogin.service 2>/dev/null || true) \
 && systemctl enable --force sddm.service \
 && dnf swap -y fedora-logos generic-logos --allowerasing \
 # Nazwa systemu: Aster (ID=fedora zostaje — po nim aktualizacje i Flatpak wiedzą, skąd brać pakiety)
 && sed -i -e 's/^NAME=.*/NAME="Aster"/' -e 's/^PRETTY_NAME=.*/PRETTY_NAME="Aster 1.0"/' \
        -e 's/^VARIANT=.*/VARIANT="Aster"/' -e 's/^LOGO=.*/LOGO=aster/' -e 's/^VERSION=.*/VERSION="1.0 (Fedora 44)"/' \
        -e '/^HOME_URL=\|^DOCUMENTATION_URL=\|^SUPPORT_URL=\|^BUG_REPORT_URL=\|^ANSI_COLOR=/d' /usr/lib/os-release \
 && echo 'ANSI_COLOR="0;38;2;124;140;255"' >> /usr/lib/os-release \
 # Ekran logowania proponuje tylko sesję Aster; Plasma zostaje ukryta (np. do ratunku przez tty)
 && for s in /usr/share/wayland-sessions/plasma*.desktop /usr/share/xsessions/plasma*.desktop; do \
        [ -f "$s" ] && sed -i '/^\[Desktop Entry\]/a NoDisplay=true\nHidden=true' "$s"; done; \
    plymouth-set-default-theme aster \
 # initramfs z ekranem Aster (ekran startowy działa, zanim zamontuje się dysk). Moduł ostree jest konieczny —
 # bez niego system po instalacji nie wybierze swojej wersji z dysku i staje w trybie awaryjnym
 # („/sysroot does not seem to be an OS tree”); dracut nie dodaje go sam przy --no-hostonly
 && kver=$(ls /usr/lib/modules | head -n1) \
 && dracut --no-hostonly --reproducible --add "ostree plymouth" -f /usr/lib/modules/$kver/initramfs.img $kver \
 && lsinitrd /usr/lib/modules/$kver/initramfs.img | grep -q ostree-prepare-root \
 && dnf clean all
RUN bootc container lint || true

# Obraz systemu Aster: Fedora Kinoite (atomowa Fedora z KDE) + powłoka Aster.
# Szkic — budowanie i instalację obrazu sprawdzimy po tym, jak powłoka będzie działać w maszynie wirtualnej.
#   podman build -f image/Containerfile -t aster:latest .
ARG FEDORA=44

FROM registry.fedoraproject.org/fedora:${FEDORA} AS build
RUN dnf install -y cmake ninja-build gcc-c++ extra-cmake-modules \
        qt6-qtbase-devel qt6-qtdeclarative-devel layer-shell-qt-devel kf6-kwindowsystem-devel kf6-kservice-devel kf6-kio-devel kf6-kconfig-devel libxcrypt-devel libvterm-devel polkit-qt6-1-devel qt6-qtwebengine-devel plasma-workspace-devel
COPY CMakeLists.txt /src/
COPY common /src/common
COPY shell /src/shell
COPY apps /src/apps
COPY session /src/session
COPY data /src/data
RUN cmake -S /src -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
 && cmake --build /build \
 && DESTDIR=/out cmake --install /build

FROM quay.io/fedora/fedora-kinoite:${FEDORA}
COPY --from=build /out/ /
RUN dnf install -y google-roboto-fonts layer-shell-qt libvterm jetbrains-mono-fonts-all \
 && kwriteconfig6 --file /etc/xdg/kdeglobals --group General --key TerminalApplication aster-terminal \
 && kwriteconfig6 --file /etc/xdg/kdeglobals --group General --key TerminalService org.aster.terminal.desktop \
 && systemctl --global enable aster-shell.service \
 && dnf clean all

# ——— Start jak w macOS: znak Aster, bez tekstu, od razu do sesji Aster ———
COPY image/boot/10-aster.toml /usr/lib/bootc/kargs.d/10-aster.toml
COPY image/boot/10-aster-sddm.conf /etc/sddm.conf.d/10-aster.conf
COPY image/boot/10-aster-plymouth.conf /usr/lib/systemd/system/sddm.service.d/10-aster-plymouth.conf
RUN dnf install -y plymouth-plugin-script sddm sddm-wayland-plasma \
 # Ekran logowania: SDDM z motywem Aster zamiast Plasma Login Manager (tamten nie przyjmuje własnych motywów)
 && (systemctl disable plasmalogin.service 2>/dev/null || true) \
 && systemctl enable --force sddm.service \
 && dnf swap -y fedora-logos generic-logos --allowerasing \
 # Nazwa systemu: Aster (ID=fedora zostaje — po nim aktualizacje i Flatpak wiedzą, skąd brać pakiety)
 && sed -i -e 's/^NAME=.*/NAME="Aster"/' -e 's/^PRETTY_NAME=.*/PRETTY_NAME="Aster 1.0"/' \
        -e 's/^VARIANT=.*/VARIANT="Aster"/' -e 's/^LOGO=.*/LOGO=aster/' -e 's/^VERSION=.*/VERSION="1.0 (Fedora 44)"/' \
        -e '/^HOME_URL=\|^DOCUMENTATION_URL=\|^SUPPORT_URL=\|^BUG_REPORT_URL=\|^ANSI_COLOR=/d' /usr/lib/os-release \
 && echo 'ANSI_COLOR="0;38;2;124;140;255"' >> /usr/lib/os-release \
 # Ekran logowania proponuje tylko sesję Aster; Plasma zostaje ukryta (np. do ratunku przez tty)
 && for s in /usr/share/wayland-sessions/plasma*.desktop /usr/share/xsessions/plasma*.desktop; do \
        [ -f "$s" ] && sed -i '/^\[Desktop Entry\]/a NoDisplay=true\nHidden=true' "$s"; done; \
    plymouth-set-default-theme aster \
 # initramfs z ekranem Aster (ekran startowy działa, zanim zamontuje się dysk)
 && kver=$(ls /usr/lib/modules | head -n1) \
 && dracut --no-hostonly --reproducible -f /usr/lib/modules/$kver/initramfs.img $kver \
 && dnf clean all
RUN bootc container lint || true

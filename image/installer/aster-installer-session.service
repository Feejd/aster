[Unit]
Description=Instalator Aster na cały ekran (KWin w trybie kiosku)
After=systemd-user-sessions.service plymouth-quit-wait.service NetworkManager.service
Conflicts=getty@tty1.service
OnFailure=getty@tty1.service

[Service]
User=liveuser
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=KDE ASTER_DARK=1 QT_QPA_PLATFORM=wayland
# Sesja D-Bus dla KWin i instalatora; po zamknięciu instalatora KWin kończy pracę, a usługa wraca
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/kwin_wayland --drm --no-lockscreen --no-global-shortcuts --exit-with-session=/usr/bin/aster-installer
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target

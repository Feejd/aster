[Desktop Entry]
Type=Application
Name=Przeglądarka
GenericName=Przeglądarka internetowa
Comment=Przeglądaj strony internetowe
Exec=aster-browser %u
Icon=internet-web-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=internet;www;strony;przeglądarka;browser;
StartupWMClass=aster-browser
Actions=new-window;

[Desktop Action new-window]
Name=Nowe okno
Exec=aster-browser

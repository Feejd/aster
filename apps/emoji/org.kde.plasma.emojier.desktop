# Aster: Win+. otwiera panel emoji Aster (org.aster.emoji) — wybierak KDE zostaje pod rzadkim skrótem
[Desktop Entry]
Exec=plasma-emojier
Name=Emoji Selector
GenericName=Emoji Selector
Comment=Copy emojis to the clipboard
OnlyShowIn=KDE;
Type=Application
Icon=preferences-desktop-emoticons
X-DBUS-StartupType=Unique
X-KDE-Shortcuts=Meta+Ctrl+Alt+Shift+Space
Categories=Qt;KDE;Utility;
Keywords=characters;unicode;punctuation;letters;emoji;emoticon;symbols;smiley face;
SingleMainWindow=true

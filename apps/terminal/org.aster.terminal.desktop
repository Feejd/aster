[Desktop Entry]
Type=Application
Name=Terminal
GenericName=Terminal
Comment=Wpisuj polecenia i uruchamiaj programy tekstowe
Exec=aster-terminal
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;

[Desktop Entry]
Type=Application
Name=Pliki
GenericName=Menedżer plików
Comment=Przeglądaj i porządkuj swoje pliki
Exec=aster-files %u
Icon=system-file-manager
Terminal=false
Categories=Qt;System;FileTools;FileManager;
MimeType=inode/directory;application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-tar;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-bzip2-compressed-tar;application/x-zstd-compressed-tar;application/vnd.ms-cab-compressed;application/x-cpio;
Keywords=pliki;foldery;eksplorator;explorer;dokumenty;zip;rar;7z;archiwum;wypakuj;spakuj;
StartupWMClass=aster-files
